# EverestSwap Devnet Configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it!

# Deployer mnemonic (12 or 24 words)
MNEMONIC=

# RPC URL (optional, defaults to devnet)
# RPC_URL=https://devnet.octrascan.io/rpc

# Indexer URL
# INDEXER_URL=http://localhost:3123

# Mainnet RPC URL (required for mainnet)
# VITE_MAINNET_RPC_URL=https://octra.network/rpc

# [V7-FIX] Explorer URL configuration
# Base URL for the block explorer. Default: devnet uses devnet.octrascan.io
# Override if using a different explorer (e.g., self-hosted).
# VITE_EXPLORER_URL_DEVNET=https://devnet.octrascan.io
# VITE_EXPLORER_URL_MAINNET=https://octrascan.io

# Transaction path template. Default: /tx.html?hash={hash}
# Use the literal placeholder "{hash}" for Octra's actual explorer format,
# or provide a plain prefix concatenated with the hash (e.g. "/tx/")
# for legacy explorers.
# VITE_EXPLORER_TX_PATH=/tx.html?hash={hash}
