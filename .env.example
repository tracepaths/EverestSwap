# EverestSwap Configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it!

# Deployer mnemonic (12 or 24 words) — used by deploy scripts only
MNEMONIC=

# Network selection: 'devnet' or 'mainnet'
# VITE_NETWORK=devnet

# ──────────────────────────────────────────────
# Devnet overrides (optional, defaults shown)
# ──────────────────────────────────────────────
# Override devnet RPC URL (default: https://devnet.octrascan.io/rpc)
# VITE_MAINNET_RPC_URL https://devnet.octrascan.io/rpc
# Override devnet indexer URL (default: https://everestswap-indexer-avax.zocomputer.io)
# VITE_INDEXER_URL=https://everestswap-indexer-avax.zocomputer.io

# ──────────────────────────────────────────────
# Mainnet configuration (required for VITE_NETWORK=mainnet)
# ──────────────────────────────────────────────
# VITE_MAINNET_RPC_URL=https://octra.network/rpc
# VITE_MAINNET_INDEXER_URL=

# Deployer identity
# VITE_MAINNET_DEPLOYER_PUBLIC_KEY=
# VITE_MAINNET_DEPLOYER_ADDRESS=

# Token contract addresses
# VITE_MAINNET_OCT_ADDRESS=
# VITE_MAINNET_WOCT_ADDRESS=
# VITE_MAINNET_OES_ADDRESS=

# Contract addresses
# VITE_MAINNET_FACTORY_ADDRESS=
# VITE_MAINNET_POOL_ADDRESS=
# VITE_MAINNET_ROUTER_ADDRESS=

# ──────────────────────────────────────────────
# Explorer URL configuration
# ──────────────────────────────────────────────
# Base URL for the block explorer.
# Devnet default:  https://devnet.octrascan.io
# Mainnet default: https://octrascan.io
# VITE_EXPLORER_URL_DEVNET=https://devnet.octrascan.io
# VITE_EXPLORER_URL_MAINNET=https://octrascan.io

# Transaction path template. Default: /tx.html?hash={hash}
# Use the literal placeholder "{hash}" for Octra's actual explorer format,
# or provide a plain prefix concatenated with the hash (e.g. "/tx/")
# for legacy explorers.
# VITE_EXPLORER_TX_PATH=/tx.html?hash={hash}
