# EverestSwap Configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit it!

# Deployer mnemonic (12 or 24 words) — used by deploy scripts only
EVERESTSWAP_MNEMONIC=

# Network selection: 'devnet' or 'mainnet'
# EVERESTSWAP_NETWORK=devnet

# ──────────────────────────────────────────────
# Devnet overrides (optional, defaults shown)
# ──────────────────────────────────────────────
# Override devnet RPC URL (default: https://devnet.octrascan.io/rpc)
# EVERESTSWAP_DEVNET_RPC_URL=https://devnet.octrascan.io/rpc
# Override devnet indexer URL (default: https://everestswap-indexer-avax.zocomputer.io)
# EVERESTSWAP_DEVNET_INDEXER_URL=https://everestswap-indexer-avax.zocomputer.io

# Devnet deployer identity (defaults are public testnet credentials)
# EVERESTSWAP_DEVNET_DEPLOYER_PUBLIC_KEY=lc+hLMhjOhHLOtk2bxw21gKLdPL9HZWEXGUVaVo9oY4=
# EVERESTSWAP_DEVNET_DEPLOYER_ADDRESS=octGXi34vZfYwi3idjSa6m34vLJCoJHNMNAGeHyqh7JVEvy

# Devnet token contract addresses
# EVERESTSWAP_DEVNET_WOCT_ADDRESS=oct4g33tzC2cJncL5RFr9TRiyk8yCNP1h2xaogiWJS5opNv
# EVERESTSWAP_DEVNET_OES_ADDRESS=octGURUy7hQhXHVcP9bovbJnpoXqCv2gpWBrk6fqtXqJ2sC

# Devnet contract addresses (V12.1 — factory with remove_pool + create/launch fix)
# EVERESTSWAP_DEVNET_FACTORY_ADDRESS=octCSV1rFyXj3wWRvLuDZRTNNtnkv24v5FQ34xuAywVKqXu
# EVERESTSWAP_DEVNET_POOL_ADDRESS=oct9SgrzmX3tyaRMoTHEfEVJLLdhsQ2kSo7ba7iFUq2S1Rh
# EVERESTSWAP_DEVNET_ROUTER_ADDRESS=octEtQJQDFC85tXtGpERHX69rNoo1GJA7EVUaLezANQxC8K

# ──────────────────────────────────────────────
# Mainnet configuration (required for EVERESTSWAP_NETWORK=mainnet)
# ──────────────────────────────────────────────
# EVERESTSWAP_MAINNET_RPC_URL=https://octra.network/rpc
# EVERESTSWAP_MAINNET_INDEXER_URL=
# EVERESTSWAP_MAINNET_DEPLOYER_PUBLIC_KEY=
# EVERESTSWAP_MAINNET_DEPLOYER_ADDRESS=
# EVERESTSWAP_MAINNET_OCT_ADDRESS=
# EVERESTSWAP_MAINNET_WOCT_ADDRESS=
# EVERESTSWAP_MAINNET_OES_ADDRESS=
# EVERESTSWAP_MAINNET_FACTORY_ADDRESS=
# EVERESTSWAP_MAINNET_POOL_ADDRESS=
# EVERESTSWAP_MAINNET_ROUTER_ADDRESS=

# ──────────────────────────────────────────────
# Explorer URL configuration
# ──────────────────────────────────────────────
# Base URL for the block explorer.
# Devnet default:  https://devnet.octrascan.io
# Mainnet default: https://octrascan.io
# EVERESTSWAP_DEVNET_EXPLORER_URL=https://devnet.octrascan.io
# EVERESTSWAP_MAINNET_EXPLORER_URL=https://octrascan.io

# Transaction path template. Default: /tx.html?hash={hash}
# Use the literal placeholder "{hash}" for Octra's actual explorer format,
# or provide a plain prefix concatenated with the hash (e.g. "/tx/")
# for legacy explorers.
# EVERESTSWAP_EXPLORER_TX_PATH=/tx.html?hash={hash}

# ──────────────────────────────────────────────
# Scripts configuration
# ──────────────────────────────────────────────
# Path to the everestswap-dev backend repo (default: ../everestswap-dev)
# EVERESTSWAP_BACKEND_PATH=
